---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { AUTHOR_NAME, TAGLINE, SOCIAL_LINKS } from "@/consts";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const featured = allPosts.slice(0, 3);

const projects = [
  {
    name: "Enterprise Guardrailed Hybrid RAG Pipeline",
    spec: "Dense + BM25 · RRF · Ragas eval",
  },
  {
    name: "Auditable Clinical Scheduling Engine",
    spec: "FastAPI · Hungarian algorithm · RBAC",
  },
];
---

<BaseLayout>
  <section class="mx-auto max-w-3xl px-6 pb-16 pt-20 sm:pt-28">
    <p class="font-mono-label text-sm text-signal dark:text-signal-dark">
      Relentlessly curious
    </p>
    <h1 class="mt-3 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
      {AUTHOR_NAME}
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft dark:text-ink-soft-dark">
      {TAGLINE}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a
        href="/blog"
        class="border border-ink bg-ink px-5 py-2.5 font-mono-label text-sm text-paper no-underline hover:bg-ink-soft dark:border-ink-dark dark:bg-ink-dark dark:text-paper-dark dark:hover:bg-ink-soft-dark"
      >
        Read the blog
      </a>
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono-label text-sm text-ink-soft no-underline hover:text-signal dark:text-ink-soft-dark dark:hover:text-signal-dark"
        >GitHub</a
      >
      <a
        href={SOCIAL_LINKS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono-label text-sm text-ink-soft no-underline hover:text-signal dark:text-ink-soft-dark dark:hover:text-signal-dark"
        >LinkedIn</a
      >
      <a
        href={`mailto:${SOCIAL_LINKS.email}`}
        class="font-mono-label text-sm text-ink-soft no-underline hover:text-signal dark:text-ink-soft-dark dark:hover:text-signal-dark"
        >Email</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-3xl border-t border-line px-6 py-14 dark:border-line-dark">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="font-mono-label text-sm text-ink-soft dark:text-ink-soft-dark">
        Featured posts
      </h2>
      <a
        href="/blog"
        class="font-mono-label text-sm text-signal no-underline hover:underline dark:text-signal-dark"
        >All posts</a
      >
    </div>
    <div>
      {
        featured.map((post) => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            body={post.body ?? ""}
          />
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl border-t border-line px-6 py-14 dark:border-line-dark">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="font-mono-label text-sm text-ink-soft dark:text-ink-soft-dark">
        Selected systems &amp; projects
      </h2>
      <a
        href="/projects"
        class="font-mono-label text-sm text-signal no-underline hover:underline dark:text-signal-dark"
        >All projects</a
      >
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((p) => (
          <a
            href="/projects"
            class="block border border-line p-5 no-underline hover:border-signal dark:border-line-dark dark:hover:border-signal-dark"
          >
            <h3 class="text-base font-semibold leading-snug">{p.name}</h3>
            <p class="font-mono-label mt-2 text-xs text-ink-soft dark:text-ink-soft-dark">
              {p.spec}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
