---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="mx-auto flex max-w-3xl flex-col items-start px-6 py-28">
    <p class="font-mono-label text-sm text-signal dark:text-signal-dark">404</p>
    <h1 class="mt-3 text-3xl font-semibold">Page not found</h1>
    <p class="mt-3 text-ink-soft dark:text-ink-soft-dark">
      Nothing's deployed at this route. It may have moved or never existed.
    </p>
    <a
      href="/"
      class="mt-6 border border-ink px-5 py-2.5 font-mono-label text-sm no-underline hover:bg-ink hover:text-paper dark:border-ink-dark dark:hover:bg-ink-dark dark:hover:text-paper-dark"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
