---
import { AUTHOR_NAME, SOCIAL_LINKS } from "@/consts";
const year = new Date().getFullYear();
---

<footer class="border-t border-line dark:border-line-dark">
  <div
    class="mx-auto flex max-w-4xl flex-col items-start justify-between gap-4 px-6 py-8 text-sm text-ink-soft sm:flex-row sm:items-center dark:text-ink-soft-dark"
  >
    <p class="font-mono-label">&copy; {year} {AUTHOR_NAME}</p>
    <div class="flex items-center gap-5 font-mono-label">
      <a
        href={SOCIAL_LINKS.github}
        class="hover:text-signal dark:hover:text-signal-dark"
        rel="me noopener noreferrer"
        target="_blank">GitHub</a
      >
      <a
        href={SOCIAL_LINKS.linkedin}
        class="hover:text-signal dark:hover:text-signal-dark"
        rel="me noopener noreferrer"
        target="_blank">LinkedIn</a
      >
      <a
        href={`mailto:${SOCIAL_LINKS.email}`}
        class="hover:text-signal dark:hover:text-signal-dark">Email</a
      >
      <a href="/rss.xml" class="hover:text-signal dark:hover:text-signal-dark"
        >RSS</a
      >
    </div>
  </div>
</footer>
