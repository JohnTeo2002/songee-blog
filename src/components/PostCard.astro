---
import Tag from "@/components/Tag.astro";
import { formatDate, toISODate } from "@/lib/format-date";
import { estimateReadingTime } from "@/lib/reading-time";

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  body: string;
}

const { slug, title, description, pubDate, tags, body } = Astro.props;
const readingTime = estimateReadingTime(body);
---

<article
  class="post-card group border-b border-line py-7 first:pt-0 dark:border-line-dark"
  data-title={title.toLowerCase()}
  data-summary={description.toLowerCase()}
  data-tags={tags.join(",")}
>
  <div
    class="font-mono-label mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-soft dark:text-ink-soft-dark"
  >
    <time datetime={toISODate(pubDate)}>{formatDate(pubDate)}</time>
    <span aria-hidden="true">/</span>
    <span>{readingTime}</span>
  </div>

  <h3 class="text-xl font-semibold leading-snug">
    <a
      href={`/blog/${slug}`}
      class="no-underline decoration-signal underline-offset-4 group-hover:underline dark:decoration-signal-dark"
    >
      {title}
    </a>
  </h3>

  <p class="mt-2 text-[0.975rem] leading-relaxed text-ink-soft dark:text-ink-soft-dark">
    {description}
  </p>

  <div class="mt-3 flex flex-wrap gap-2">
    {tags.map((tag) => <Tag tag={tag} />)}
  </div>
</article>
